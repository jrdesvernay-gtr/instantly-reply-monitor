# Instantly v2 API key (Settings → API Keys)
INSTANTLY_API_KEY=your_instantly_api_key_here

# Slack Incoming Webhook URL
# Create one at: https://api.slack.com/apps → Your App → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXXXXXX/XXXXXXXXX/XXXXXXXXXXXXXXXXXXXXXXXX

# --- Optional tuning ---

# Hours to wait before sending a notification (default: 24)
NOTIFY_AFTER_HOURS=24

# Notification window size in hours (default: 24)
# Leads are notified when they fall between NOTIFY_AFTER_HOURS and
# NOTIFY_AFTER_HOURS + WINDOW_HOURS old. This prevents double-notifications
# without needing a database. Default = 24h window (24–48h old leads).
WINDOW_HOURS=24

# Set to "true" to log without sending Slack notifications (for testing)
DRY_RUN=false

# Set to "true" to post a run summary to Slack after each check
SEND_SLACK_SUMMARY=false

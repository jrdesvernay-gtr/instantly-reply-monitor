# Instantly v2 API key (Settings → API Keys)
INSTANTLY_API_KEY=your_instantly_api_key_here

# Resend — get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Who to notify (your email)
NOTIFY_TO_EMAIL=jean@baitshop.co

# Sender address — must be from a domain verified in Resend
# During testing you can use: onboarding@resend.dev (sends only to your verified email)
NOTIFY_FROM_EMAIL=monitor@yourdomain.com

# --- Optional tuning ---
NOTIFY_AFTER_HOURS=24
WINDOW_HOURS=24
DRY_RUN=false
SEND_EMAIL_SUMMARY=false
